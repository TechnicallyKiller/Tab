{
  "$schema": "https://biomejs.dev/schemas/2.5.9/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "**",
      "!**/dist",
      "!**/.next",
      "!**/.turbo",
      "!**/coverage",
      "!**/drizzle",
      "!**/next-env.d.ts",
      "!**/*.css",
      "!surface-selection-decision",
      "!.agents"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "semicolons": "asNeeded",
      "trailingCommas": "all"
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "suspicious": {
        "noExplicitAny": "error",
        "noConsole": "error"
      },
      "complexity": {
        "noExcessiveCognitiveComplexity": "off",
        "useLiteralKeys": "off",
        "noImportantStyles": "off"
      },
      "style": {
        "useNamingConvention": "off",
        "noNonNullAssertion": "off",
        "useTemplate": "off"
      },
      "nursery": {
        "preset": "none"
      }
    }
  },
  "overrides": [
    {
      "includes": [
        "apps/**",
        "tools/**",
        "agents/**",
        "packages/mcp/**",
        "packages/testkit/**",
        "packages/mirror/src/live-check.ts",
        "**/*.test.ts",
        "**/vitest.config.ts"
      ],
      "linter": {
        "rules": {
          "suspicious": {
            "noConsole": "off"
          }
        }
      }
    }
  ]
}
