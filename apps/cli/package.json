  },
  "dependencies": {
    "@tab/money": "workspace:*",
    "@tab/params": "workspace:*",
    "@tab/protocol": "workspace:*",
    "@tab/sdk": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "typescript": "^5.9.0"
  }
}
