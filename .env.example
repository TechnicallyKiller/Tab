# ── Hedera ────────────────────────────────────────────────────────────────────
# From portal.hedera.com. Free, includes testnet HBAR.
HEDERA_NETWORK=testnet
HEDERA_OPERATOR_ID=0.0.xxxxx
HEDERA_OPERATOR_KEY=

# ── Float accounts ────────────────────────────────────────────────────────────
# Two accounts, two roles. See docs/adr/0003-two-account-float.md and docs/KEYS.md.
#
# Cold Treasury: threshold KeyList, holds the bulk, signs only top-ups.
TREASURY_ACCOUNT_ID=0.0.xxxxx
TREASURY_KEY_LIST=

# Hot Float: single key, capped balance, signs every spend-leg payment.
# The x402 exact scheme needs a signature per request, so this cannot be multi-sig.
HOT_FLOAT_ACCOUNT_ID=0.0.xxxxx
HOT_FLOAT_KEY=
HOT_FLOAT_CAP_USDC=50.00
HOT_FLOAT_REFILL_THRESHOLD_USDC=10.00

# ── HCS topics ────────────────────────────────────────────────────────────────
# Created by `pnpm bootstrap`, which prints these for you to paste back.
TOPIC_RECEIPTS=0.0.xxxxx
TOPIC_CEILINGS=0.0.xxxxx
TOPIC_SETTLEMENTS=0.0.xxxxx

# ── Faucet relay (temporary) ───────────────────────────────────────────────────
# Circle's faucet wants a 0x EVM address, and an ED25519 operator has none —
# only a synthetic long-zero form that EVM-oriented forms reject. `pnpm
# evm:account` creates an ECDSA account with a real EVM alias and prints these;
# `pnpm faucet:sweep` forwards the drip to the operator. Delete once funded.
FAUCET_ACCOUNT_ID=
FAUCET_ACCOUNT_KEY=

# ── Managed infrastructure ────────────────────────────────────────────────────
# Supabase: use the DIRECT connection on 5432, not the pooler on 6543.
# Drizzle migrations need prepared statements and DDL, which the pooler mishandles.
DATABASE_URL=postgresql://postgres:...@db.xxx.supabase.co:5432/postgres

# Upstash: create it in the SAME REGION as the gateway. The fast path is
# budgeted under 50ms and a cross-region round trip eats most of that.
REDIS_URL=rediss://default:...@xxx.upstash.io:6379

# ── x402 ──────────────────────────────────────────────────────────────────────
# We self-facilitate the EARN leg (ADR-0004), so no facilitator URL is needed there.
# The SPEND leg uses whatever facilitator each seller advertises in its 402.
# Probe 2 determines whether our demo sellers need an override here.
X402_SPEND_FACILITATOR_URL=
X402_FACILITATOR_ENABLED=true

# The spendable token. Defaults to real testnet USDC; set to a minted stand-in
# only if the faucet is unavailable (Probe 1 fallback). Must be 6 decimals
# either way, or MicroUsdc misreads every amount.
#   pnpm token:check   report what the operator holds
#   pnpm token:mint    create the stand-in
USDC_TOKEN_ID=0.0.429274

# NOT configured here — imported from @x402/hedera as constants:
#   HEDERA_USDC_DECIMALS (6)
#   HEDERA_TESTNET_CAIP2 (hedera:testnet) · HEDERA_TESTNET_MIRROR_NODE_URL
# A second copy is a second source of truth. Don't.

# ── Runtime ───────────────────────────────────────────────────────────────────
# Credit parameters live in @tab/params behind MODEL_VERSION, NOT here --
# verify-ceiling must recompute with byte-identical values.
# The window length is the one documented override, and it appears in `tab config`.
TAB_ENV=development
DEMO_MODE=true
WINDOW_SECONDS=300           # 3600 in normal operation
LOG_LEVEL=debug
GATEWAY_PORT=8080
