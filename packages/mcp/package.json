{
  "name": "@tab/mcp",
  "version": "0.1.1",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "tab-mcp": "./dist/stdio.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test:unit": "node --experimental-strip-types --test src/*.test.ts",
    "start": "node --experimental-strip-types src/stdio.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.13.0",
    "@tab/money": "workspace:*",
    "@tab/protocol": "workspace:*",
    "@tab/sdk": "workspace:*",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "typescript": "^5.9.0"
  },
  "description": "MCP server for Tab \u2014 give any LLM a credit line on Hedera. It holds no key.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/0xNerd100/Tab.git",
    "directory": "packages/mcp"
  },
  "homepage": "https://github.com/0xNerd100/Tab#readme",
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "dist/**/*.map",
    "README.md"
