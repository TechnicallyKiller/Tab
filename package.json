{
  "name": "tab",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.13.1",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:unit": "turbo run test:unit",
    "test:integration": "turbo run test:integration",
    "lint": "biome check .",
    "format": "biome check --write .",
    "clean": "turbo run clean && rm -rf node_modules",
    "guard": "pnpm guard:solidity && pnpm guard:sdk && pnpm guard:boundaries && pnpm guard:money && pnpm guard:secrets",
    "guard:solidity": "node tools/guards/no-solidity.mjs",
    "guard:sdk": "node tools/guards/single-hedera-sdk.mjs",
    "guard:boundaries": "node tools/guards/check-boundaries.mjs",
    "guard:money": "node tools/guards/no-float-money.mjs",
    "probe": "pnpm --filter @tab/probes start",
    "bootstrap": "pnpm --filter @tab/bootstrap start",
    "dev": "turbo run dev --parallel",
    "dev:gateway": "pnpm --filter @tab/gateway dev",
    "demo:honest": "pnpm --filter @tab/honest-agent start",
    "db:generate": "pnpm --filter @tab/db generate",
    "db:migrate": "pnpm --filter @tab/db migrate",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "turbo run build --filter='./packages/*' && changeset publish",
    "dev:web": "pnpm --filter @tab/web dev",
    "build:web": "pnpm --filter @tab/web build",
    "guard:secrets": "node tools/guards/no-secrets.mjs",
    "token:check": "pnpm --filter @tab/bootstrap token:check",
    "token:mint": "pnpm --filter @tab/bootstrap token:mint",
    "probe3": "pnpm --filter @tab/bootstrap probe3",
    "chain:status": "pnpm --filter @tab/bootstrap status",
    "evm:account": "pnpm --filter @tab/bootstrap evm:account",
    "faucet:sweep": "pnpm --filter @tab/bootstrap faucet:sweep",
    "faucet:watch": "pnpm --filter @tab/bootstrap faucet:watch",
    "probe:x402": "pnpm --filter @tab/probes probe:x402",
    "seller:create": "pnpm --filter @tab/bootstrap seller:create",
    "probe:x402:hts": "pnpm --filter @tab/probes probe:x402:hts",
    "probe:latency": "pnpm --filter @tab/probes probe:latency",
    "probe:schedule": "pnpm --filter @tab/probes probe:schedule",
    "probe:adapter": "pnpm --filter @tab/probes probe:adapter",
    "probe:adapter:hts": "pnpm --filter @tab/probes probe:adapter:hts",
    "probe:protocol": "pnpm --filter @tab/probes probe:protocol",
    "start:gateway": "pnpm --filter @tab/gateway start",
    "seller": "pnpm --filter @tab/testkit seller",
    "agent:endpoint": "pnpm --filter @tab/honest-agent endpoint",
    "demo:earn": "pnpm --filter @tab/testkit payer",
    "fund:payer": "pnpm --filter @tab/bootstrap fund:payer",
    "payer:create": "pnpm --filter @tab/bootstrap payer:create",
    "settle": "pnpm --filter @tab/settlement tick",
    "reconcile": "pnpm --filter @tab/settlement reconcile",
    "tab:create": "pnpm --filter @tab/bootstrap tab:create",
    "engine": "pnpm --filter @tab/engine start",
    "engine:once": "pnpm --filter @tab/engine recompute",
    "attack": "pnpm --filter @tab/loop-attacker attack",
    "verify-tab": "pnpm --filter @tab/verify verify-tab",
    "verify-ceiling": "pnpm --filter @tab/verify verify-ceiling",
    "demo:payer": "pnpm --filter @tab/bootstrap demo:payer"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.0",
    "@changesets/cli": "^2.29.0",
    "@types/node": "^22.15.0",
    "tsup": "^8.5.0",
    "tsx": "^4.20.0",
    "turbo": "^2.5.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
